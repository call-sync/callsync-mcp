    {
      "name": "trigger_analysis",
      "icons": [
        {
          "src": "https://mcp.callsyncapp.com/assets/branding/logo-icon.png",
          "mimeType": "image/png",
          "sizes": [
            "512x512"
          ]
        },
        {
          "src": "https://mcp.callsyncapp.com/assets/branding/logo-icon.svg",
          "mimeType": "image/svg+xml",
          "sizes": [
            "any"
          ]
        }
      ],
      "description": "Trigger AI transcription and analysis for a recorded call. Costs transcription credits: 1 credit per 15 seconds of audio (minimum 1) \u2014 the org's balance is verified against this call's duration before queueing. Processing is async; fetch the result via list_calls after a minute or two. Use get_account_status to check the remaining credit balance.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "call_id": {
            "type": "number",
            "description": "The unique ID of the call log entry containing a recording file URL."
          }
        },
        "required": [
          "call_id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Success message indicating the analysis job has been queued and the estimated credit cost."
          }
        },
        "required": [
          "message"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "get_account_status",
      "icons": [
        {
          "src": "https://mcp.callsyncapp.com/assets/branding/logo-icon.png",
          "mimeType": "image/png",
          "sizes": [
            "512x512"
          ]
        },
        {
          "src": "https://mcp.callsyncapp.com/assets/branding/logo-icon.svg",
          "mimeType": "image/svg+xml",
          "sizes": [
            "any"
          ]
        }
      ],
      "description": "Get the organization's account status: whether AI transcription is enabled, remaining transcription credits (1 credit = 15 seconds of audio), auto-transcribe setting, and timezone. Use this to answer questions like 'how many credits do I have left?' or before triggering analysis on long calls.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "organization": {
            "type": "string",
            "description": "Organization name."
          },
          "timezone": {
            "type": "string",
            "description": "Organization's local timezone."
          },
          "transcription_enabled": {
            "type": "boolean",
            "description": "Whether AI transcription is enabled for this organization."
          },
          "auto_transcribe": {
            "type": "boolean",
            "description": "Whether new recorded calls are transcribed automatically."
          },
          "transcription_credits": {
            "type": "number",
            "description": "Remaining transcription credits."
          },
          "approx_audio_minutes_remaining": {
            "type": "number",
            "description": "Approximate minutes of call audio the remaining credits cover."
          },
          "credit_pricing": {
            "type": "string",
            "description": "How credits are consumed."
          }
        },
        "required": [
          "transcription_enabled",
          "transcription_credits"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
