{
  "tools": [
    {
      "name": "list_calls",
      "icons": [
        {
          "src": "https://mcp.callsyncapp.com/assets/branding/logo-icon.png",
          "mimeType": "image/png",
          "sizes": [
            "512x512"
          ]
        },
        {
          "src": "https://mcp.callsyncapp.com/assets/branding/logo-icon.svg",
          "mimeType": "image/svg+xml",
          "sizes": [
            "any"
          ]
        }
      ],
      "description": "Find calls with compact metadata only. Use get_call_details for full transcript/analysis and get_recording_link for audio. Supports date range, employee, review status, direction, search and pagination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5
          },
          "search": {
            "type": "string",
            "description": "Optional search query to filter calls by caller phone, caller name, call note, employee name, caller note, or AI summary/transcription/reason/sentiment."
          },
          "direction": {
            "type": "string",
            "enum": [
              "incoming",
              "outgoing",
              "missed",
              "rejected",
              "blocked",
              "unknown"
            ]
          },
          "employee_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Employee ID from list_employees."
          },
          "reviewed": {
            "type": "boolean"
          },
          "after": {
            "type": "string",
            "description": "Inclusive start ISO timestamp with timezone."
          },
          "before": {
            "type": "string",
            "description": "Exclusive end ISO timestamp with timezone."
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "list_callers",
      "icons": [
        {
          "src": "https://mcp.callsyncapp.com/assets/branding/logo-icon.png",
          "mimeType": "image/png",
          "sizes": [
            "512x512"
          ]
        },
        {
          "src": "https://mcp.callsyncapp.com/assets/branding/logo-icon.svg",
          "mimeType": "image/svg+xml",
          "sizes": [
            "any"
          ]
        }
      ],
      "description": "List recent unique callers (limit 20). Supports search.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "default": 1,
            "description": "The page number to retrieve, for pagination (1-based)."
          },
          "search": {
            "type": "string",
            "description": "Optional search query to filter callers by phone number, name, or identity notes."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "description": "List of callers with aggregate activity stats.",
            "items": {
              "type": "object",
              "properties": {
                "phone": {
                  "type": "string",
                  "description": "Phone number of the caller."
                },
                "name": {
                  "type": "string",
                  "description": "Name of the caller (defaults to 'Unknown')."
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "General contact note/context about the caller."
                },
                "labels": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  },
                  "description": "Tags/labels assigned to this caller."
                },
                "activity": {
                  "type": "object",
                  "description": "Aggregate call activity statistics.",
                  "properties": {
                    "total_calls": {
                      "type": "number",
                      "description": "Total number of calls tracked from this caller."
                    },
                    "total_duration": {
                      "type": "string",
                      "description": "Sum of call durations with suffix 's' (e.g. '120s')."
                    },
                    "last_interaction": {
                      "type": "string",
                      "description": "ISO 8601 UTC timestamp of the most recent interaction."
                    },
                    "last_type": {
                      "type": "string",
                      "description": "Direction of the last call ('incoming' or 'outgoing')."
                    }
                  }
                }
              }
            }
          },
          "total": {
            "type": "number",
            "description": "Total number of callers matching the search."
          },
          "page": {
            "type": "number",
            "description": "Current page index."
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "list_employees",
      "icons": [
        {
          "src": "https://mcp.callsyncapp.com/assets/branding/logo-icon.png",
          "mimeType": "image/png",
          "sizes": [
            "512x512"
          ]
        },
        {
          "src": "https://mcp.callsyncapp.com/assets/branding/logo-icon.svg",
          "mimeType": "image/svg+xml",
          "sizes": [
            "any"
          ]
        }
      ],
      "description": "List employees/devices in the org. Shows name, phone, last sync, battery, device model, archived status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string",
            "description": "Optional search query to filter employees by name, phone number, device phone, email, or device model."
          },
          "include_archived": {
            "type": "boolean",
            "default": false,
            "description": "Whether to include archived employees in the returned list."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "description": "List of employee sync status records.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "number",
                  "description": "Unique database ID of the employee record."
                },
                "name": {
                  "type": "string",
                  "description": "Full name of the employee."
                },
                "phone": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Employee personal or business phone number."
                },
                "device_phone": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Phone number of the active sync device."
                },
                "email": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Email address of the employee."
                },
                "device_model": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Synced device model name (e.g. 'Samsung Galaxy S23')."
                },
                "os_version": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Operating system version (e.g., 'Android 14')."
                },
                "battery_level": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Battery level percentage (0 to 100)."
                },
                "last_sync": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "ISO 8601 UTC timestamp of the last successful sync run."
                },
                "is_archived": {
                  "type": "boolean",
                  "description": "Archived status of the employee."
                },
                "created_at": {
                  "type": "string",
                  "description": "ISO 8601 UTC timestamp of when employee was registered."
                }
              }
            }
          },
          "total": {
            "type": "number",
            "description": "Total number of employees matching the active filters."
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
